GMAIL_CREDENTIALS_FILE=client_secret.json
GMAIL_TOKEN_FILE=token.json
GMAIL_CURSOR_FILE=.velo_gmail_cursor
GMAIL_USER=me
GEMINI_API_KEY=
DATABASE_PATH=velo.db
GMAIL_LOOKBACK_DAYS=90
MOCK_SITE_URL=http://127.0.0.1:5000
AGENT_MAX_STEPS=15
AGENT_SCREENSHOT_DIR=agent_screenshots
NOTIFY_CLICK_TIMEOUT=120
POLL_INTERVAL_SECONDS=60
# regex (no API calls) | hybrid (regex, then Gemini for unreadable emails) | gemini
EXTRACTION_MODE=regex
GEMINI_MODEL=gemini-2.5-flash
# Sandbox the cancel button opens: auto (each alerted subscription gets the next one in turn) | classic | maze | trick | pause_trap | buried
AGENT_SCENARIO=auto
# Currency the dashboard charts are drawn in (USD, INR, EUR, GBP, ...); tables keep original currencies
DISPLAY_CURRENCY=USD
